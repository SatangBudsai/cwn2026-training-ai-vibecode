    string memberId FK
    string categoryId FK
    int value "-1 หรือ +1"
  }
  RESTAURANT_VOTE {
    string memberId FK
    int restaurantId FK
    int value "-1 หรือ +1"
  }
  DRAW {
    string id PK
    string roomCode FK "null = คนเดียว"
